# Copy this file to .env for local development. On Railway, set these as
# environment variables in the project settings instead — never commit .env.

NODE_ENV=development
PORT=3000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Only needed if you attach a persistent volume (recommended on Railway).
# Point it at the volume's mount path, e.g. DB_PATH=/data/sgn.sqlite
# Leave unset for local development — it defaults to ./storage/sgn.sqlite
DB_PATH=
